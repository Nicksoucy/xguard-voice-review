{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": false },
  "linter": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "files": {
    "include": ["lib/**/*.js", "tests/**/*.mjs", "*.mjs"],
    "ignore": ["node_modules", "test-results", "playwright-report", "coverage"]
  }
}
